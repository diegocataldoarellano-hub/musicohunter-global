DATABASE_URL=sqlite:///./music_hunter.db
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ADMIN_TOKEN=change-me

# Optional open-source external model endpoint.
# Use any OpenAI-compatible endpoint serving an open-weight model.
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# Optional Google Programmable Search for discovery missions.
# The agent uses this to find public Instagram/TikTok/media/booking/venue pages.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
DISCOVERY_COUNTRY_LIMIT=67
DISCOVERY_QUERIES_PER_COUNTRY=4
DISCOVERY_RESULTS_PER_QUERY=5
